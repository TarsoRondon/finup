# Variáveis de ambiente para o FinUp Frontend
# Preencha com os dados do seu projeto no Firebase Console (Configurações do Projeto > Geral > Seus Apps)

VITE_FIREBASE_API_KEY=sua_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123def456

# APIs de Mercado Financeiro (Opcionais)
VITE_BRAPI_TOKEN=seu_token_brapi
VITE_COINGECKO_API_KEY=sua_chave_coingecko
